# ============================================
# Visto — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# O `.env` NÃO deve ser commitado.
# ============================================

# --- Supabase ---
# Dashboard do Supabase > Project Settings > API
# Use a `anon public` key. NUNCA a `service_role`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google OAuth (login social) ---
# Dashboard do Supabase > Authentication > Providers > Google
# > Client ID do Google Cloud Console (OAuth 2.0 Web)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# O app calcula o redirect URI sozinho (visto://auth/callback no Android).
# Cadastre o MESMO valor aqui no Supabase e no Google Cloud, senão o
# login volta com "redirect_uri mismatch".
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=visto://auth/callback

# --- Stripe ---
# Dashboard do Stripe > Productos > criar assinatura mensal de R$29,90
# Use o ID do preço no formato `price_...`
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=
EXPO_PUBLIC_STRIPE_PRECO_ID=

# --- Stripe: Payment Link (o que a Etapa 7 usa de verdade) ---
# Dashboard do Stripe > Payment Links > create > escolha o preço de R$29,90
# > copie o link https://buy.stripe.com/...
#
# Esse link abre o checkout hospedado do Stripe FORA do app. Sem backend o
# app NÃO consegue confirmar o pagamento — quem confirma é o Stripe. A
# verificação automática (Edge Function + polling em `assinaturas`) é a
# fase 2, descrita no README.
EXPO_PUBLIC_STRIPE_PAYMENT_LINK=
